{
    "name": "entre-redes/cambios",
    "description": "WordPress plugin: player change/substitution calendar and lifecycle for the Entre Redes football league",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "^7.0",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EntreRedes\\Cambios\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EntreRedes\\Cambios\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.33"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
