{
    "name": "entre-redes/campeones",
    "description": "WordPress plugin: Copa Chaminade historical championship record for the Entre Redes football league",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EntreRedes\\Campeones\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EntreRedes\\Campeones\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
